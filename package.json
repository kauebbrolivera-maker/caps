{
  "name": "caps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Caps — editor de vídeo mobile-first, 100% no aparelho (PWA)",
  "scripts": {
    "prepare-assets": "node scripts/copy-ffmpeg.mjs && node scripts/icons.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && vite build",
    "preview": "vite preview --port 4173",
    "shots": "node test/shots.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^3.8.1",
    "mp4-muxer": "^5.2.2"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^5.4.21"
  }
}
